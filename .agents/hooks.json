{
  "trellis": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/session-start.py",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/inject-workflow-state.py",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/pre-tool-priority.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/session-end.py",
        "timeout": 30
      }
    ]
  }
}
